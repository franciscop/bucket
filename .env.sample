# Real cloud credentials for the integration suite (test/index.test.ts).
# To test S3/R2/GCS/Azure WITHOUT credentials, use the emulators instead. See
# .env.emulators and the "Testing" section of the readme.

FS_PUBLIC_URL=

B2_BUCKET=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_PUBLIC_URL=
B2_SEEDED=

AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
# Endpoint WITHOUT the bucket name, which the library appends
AWS_ENDPOINT_URL=
AWS_PUBLIC_URL=
AWS_SEEDED=

R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_REGION=
# Only for custom endpoints; derived from R2_ACCOUNT_ID otherwise
R2_URL=
R2_PUBLIC_URL=
R2_SEEDED=

# Either provide client_email + private_key, or a path to a service account JSON file
GCS_BUCKET=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_PUBLIC_URL=
GCS_SEEDED=

AZURE_ACCOUNT=
AZURE_CONTAINER=
AZURE_KEY=
AZURE_CONNECTION_STRING=
AZURE_URL=
AZURE_PUBLIC_URL=
AZURE_SEEDED=

# GCS_URL + GCS_ANONYMOUS point the GCS provider at an emulator
# (fake-gcs-server). AWS_ENDPOINT_URL / R2_URL do the same for MinIO.
